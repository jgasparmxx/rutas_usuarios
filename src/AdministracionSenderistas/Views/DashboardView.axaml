<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AdministracionSenderistas.ViewModels"
             xmlns:views="using:AdministracionSenderistas.Views"
             xmlns:models="using:AdministracionSenderistas.Models"
             x:Class="AdministracionSenderistas.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="#0B0F19">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,16,16">

        <!-- ROW 0: TOP HEADER BAR -->
        <Border Grid.Row="0"
                Background="#131B2B"
                BorderBrush="#253248"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            CornerRadius="8"
                            Background="#064E3B"
                            BorderBrush="#10B981"
                            BorderThickness="1">
                        <TextBlock Text="▲"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#34D399"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ADMINISTRACIÓN SENDERISTAS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   LetterSpacing="0.8" />
                        <TextBlock Text="Panel de Gestión BD PostgreSQL (Neon) &amp; PostgREST"
                                   FontSize="11"
                                   Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- User Session & Connection Status Badge -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- User badge -->
                    <Border Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="👤" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       VerticalAlignment="Center" />
                            <!-- Role Pill Badge -->
                            <Border Background="#065F46"
                                    CornerRadius="10"
                                    Padding="8,2">
                                <TextBlock Text="{Binding CurrentUserRole}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#6EE7B7" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Actions (Sync All & Logout) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary"
                            Command="{Binding SyncAllTablesCommand}"
                            ToolTip.Tip="Forzar Sincronización Manual (Usar si falla el internet)"
                            Padding="10,6"
                            Width="50" Height="40"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <TextBlock Text="⟳" FontWeight="Bold" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Classes="danger"
                            Command="{Binding LogoutCommand}"
                            ToolTip.Tip="Cerrar la sesión actual">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Cerrar Sesión" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: STATUS / NOTIFICATION BANNER -->
        <Border Grid.Row="1"
                Background="#16253B"
                BorderBrush="#1E3A5F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12"
                IsVisible="{Binding IsBannerVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="ℹ" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding StatusBanner}"
                               Foreground="#BAE6FD"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Height="2"
                             Margin="20,0"
                             Foreground="#38BDF8"
                             Background="#1E293B"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ROW 2: MAIN CONTENT (LEFT: MENU TABLAS COLAPSIBLE, RIGHT: GRID/FORM TABS) -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">

            <!-- LEFT AREA: MENU DE TABLAS (COLAPSIBLE) -->
            <Border Grid.Column="0"
                    Width="{Binding SidebarWidth}"
                    Background="#131B2B"
                    BorderBrush="#253248"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,12"
                    Margin="0,0,12,0">

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header with Toggle Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <!-- Expanded Header -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsSidebarCollapsed}">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="TABLAS BD"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"
                                           LetterSpacing="1.1" />
                                <TextBlock Text="PostgreSQL Neon"
                                           FontSize="10"
                                           Foreground="#64748B" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    Command="{Binding ToggleSidebarCommand}"
                                    Padding="6,4"
                                    Width="30"
                                    Height="28"
                                    ToolTip.Tip="Contraer menú lateral">
                                <TextBlock Text="◀" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </Grid>

                        <!-- Collapsed Header -->
                        <Button Classes="secondary"
                                Command="{Binding ToggleSidebarCommand}"
                                Padding="4"
                                Width="36"
                                Height="28"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding IsSidebarCollapsed}"
                                ToolTip.Tip="Expandir menú lateral">
                            <TextBlock Text="▶" FontSize="11" FontWeight="Bold" />
                        </Button>
                    </Grid>

                    <!-- Table Navigation Buttons (Sin números de registro, colapsables con tooltip) -->
                    <StackPanel Grid.Row="1" Spacing="6">

                        <!-- Senderistas -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="Senderistas"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Senderistas (Usuarios y roles)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="👥" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Senderistas" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Usuarios y roles" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Rutas -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="Rutas"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Rutas (Senderos y distancias)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="🗺" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Rutas" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Senderos y distancias" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Agrupaciones -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="Agrupaciones"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Agrupaciones (Clubs y asociaciones)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="🏛" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Agrupaciones" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Clubs y asociaciones" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Invitaciones a Rutas -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="Invitaciones"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Invitaciones (Salidas y convocatorias)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="✉" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Invitaciones" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Salidas y convocatorias" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Participantes -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="Participantes"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Participantes (Inscripciones a salidas)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="🎒" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Participantes" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Inscripciones a salidas" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Frases Dificultad -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="FrasesDificultad"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Frases Dificultad (Textos por nivel de reto)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="💬" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Frases Dificultad" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Textos por nivel" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Requisitos Senderismo -->
                        <Button Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectTableCommand}"
                                CommandParameter="RequisitosSenderismo"
                                Height="44"
                                Padding="4,4"
                                ToolTip.Tip="Requisitos (Equipo, ropa y seguridad)">
                            <Grid ColumnDefinitions="36,*">
                                <TextBlock Grid.Column="0" Text="📋" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="Requisitos" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                                    <TextBlock Text="Equipo y seguridad" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                    </StackPanel>

                    <!-- Bottom System & Cache Info Box -->
                    <Border Grid.Row="2"
                            Background="#0B0F19"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,14,0,0"
                            IsVisible="{Binding !IsSidebarCollapsed}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="⚡ Modo Activo" FontWeight="SemiBold" FontSize="10" Foreground="#38BDF8" />
                            <TextBlock Text="• Caché SQLite local" FontSize="9" Foreground="#94A3B8" />
                            <TextBlock Text="• API PostgREST Neon" FontSize="9" Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- RIGHT AREA: TABS (TAB 1: GRID, TAB 2: FORMULARIO) -->
            <Border Grid.Column="1"
                    Background="#131B2B"
                    BorderBrush="#253248"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">

                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            Padding="16">

                    <!-- ============================================== -->
                    <!-- TAB 1: GRID DE DATOS (VISUALIZACIÓN)           -->
                    <!-- ============================================== -->
                    <TabItem Header="📋 Listado y Visualización (Grid)"
                             FontSize="13"
                             FontWeight="SemiBold">
                        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">

                            <!-- Filter & Action Toolbar -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">

                                <!-- Search Box -->
                                <TextBox Grid.Column="0"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Watermark="🔍 Buscar en tabla actual (correo, nombre, id, teléfono...)"
                                         Margin="0,0,8,0" />

                                <!-- Optional Role Filter (Visible on Senderistas) -->
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding FilterRole, Mode=TwoWay}"
                                          Margin="0,0,8,0"
                                          Width="150">
                                    <ComboBoxItem Content="Todos" />
                                    <ComboBoxItem Content="O" />
                                    <ComboBoxItem Content="A" />
                                    <ComboBoxItem Content="G" />
                                    <ComboBoxItem Content="S" />
                                </ComboBox>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="primary"
                                            Command="{Binding NewRecordCommand}"
                                            IsVisible="{Binding CanCreateNew}"
                                            ToolTip.Tip="Crear nuevo registro">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="+" FontWeight="Bold" />
                                            <TextBlock Text="Nuevo" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary"
                                            Command="{Binding EditSelectedCommand}"
                                            IsEnabled="{Binding HasSelectedRecord}"
                                            ToolTip.Tip="Ver y editar registro seleccionado en formulario">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✏" />
                                            <TextBlock Text="Ver / Editar" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="danger"
                                            Command="{Binding DeleteSelectedCommand}"
                                            IsEnabled="{Binding CanDeleteSelected}"
                                            ToolTip.Tip="Eliminar registro seleccionado">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="🗑" />
                                            <TextBlock Text="Eliminar" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary"
                                            Command="{Binding RefreshCurrentTableCommand}"
                                            ToolTip.Tip="Refrescar datos desde API / Caché">
                                        <TextBlock Text="⟳" FontWeight="Bold" />
                                    </Button>

                                    <Button Classes="secondary"
                                            Command="{Binding ExportCsvCommand}"
                                            ToolTip.Tip="Exportar vista a archivo CSV">
                                        <TextBlock Text="⬇ CSV" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrids Container: Switches between tables -->
                            <Panel Grid.Row="1">

                                <!-- DATAGRID: SENDERISTAS -->
                                <DataGrid ItemsSource="{Binding FilteredSenderistas}"
                                          SelectedItem="{Binding SelectedSenderista, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Senderistas}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="210" />
                                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding Nombre}" Width="190" />
                                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                                        <DataGridTextColumn Header="Sexo" Binding="{Binding Sexo}" Width="70" />
                                        <DataGridTextColumn Header="Nivel" Binding="{Binding NivelSenderista}" Width="110" />
                                        <DataGridTextColumn Header="Fecha Nacimiento" Binding="{Binding FechaNacimiento}" Width="130" />
                                        <DataGridTextColumn Header="Mín. Distancia" Binding="{Binding MinimoLongitudKm}" Width="120" />
                                        <DataGridTextColumn Header="Rol" Binding="{Binding RolDescripcion}" Width="140" />
                                        <DataGridCheckBoxColumn Header="Bloqueado" Binding="{Binding Bloqueado}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DATAGRID: RUTAS -->
                                <DataGrid ItemsSource="{Binding FilteredRutas}"
                                          SelectedItem="{Binding SelectedRuta, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Rutas}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Ruta" Binding="{Binding Id}" Width="140" />
                                        <DataGridTextColumn Header="Nombre de la Ruta" Binding="{Binding Nombre}" Width="220" />
                                        <DataGridTextColumn Header="Distancia" Binding="{Binding DistanciaKmFormateada}" Width="110" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="110" />
                                        <DataGridTextColumn Header="Dificultad" Binding="{Binding Dificultad}" Width="110" />
                                        <DataGridCheckBoxColumn Header="Pública" Binding="{Binding Publico}" Width="90" />
                                        <DataGridTextColumn Header="Agrupación" Binding="{Binding Agrupacion}" Width="110" />
                                        <DataGridTextColumn Header="Email Creador" Binding="{Binding EmailCreador}" Width="180" />
                                        <DataGridTextColumn Header="Duración Est." Binding="{Binding DuracionEstimada}" Width="120" />
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="250" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DATAGRID: AGRUPACIONES -->
                                <DataGrid ItemsSource="{Binding FilteredAgrupaciones}"
                                          SelectedItem="{Binding SelectedAgrupacion, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Agrupaciones}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Agrupación" Binding="{Binding IdAgrupacion}" Width="130" />
                                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200" />
                                        <DataGridTextColumn Header="Logo" Binding="{Binding TieneLogoTexto}" Width="80" />
                                        <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="160" />
                                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="130" />
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                                        <DataGridTextColumn Header="Fecha Creación" Binding="{Binding FechaCreacion}" Width="140" />
                                        <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="130" />
                                        <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="150" />
                                        <DataGridTextColumn Header="Clave (Admin Rol 'A')" Binding="{Binding Clave}" Width="200" />
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="240" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DATAGRID: INVITACIONES -->
                                <DataGrid ItemsSource="{Binding FilteredInvitaciones}"
                                          SelectedItem="{Binding SelectedInvitacion, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Invitaciones}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Invitación" Binding="{Binding IdInvitacion}" Width="140" />
                                        <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="220" />
                                        <DataGridTextColumn Header="ID Ruta" Binding="{Binding IdRuta}" Width="130" />
                                        <DataGridTextColumn Header="Fecha de Salida" Binding="{Binding FechaSalida}" Width="150" />
                                        <DataGridTextColumn Header="Punto de Encuentro" Binding="{Binding PuntoEncuentro}" Width="180" />
                                        <DataGridTextColumn Header="Agrupación" Binding="{Binding IdAgrupacion}" Width="110" />
                                        <DataGridTextColumn Header="Organizador" Binding="{Binding EmailOrganizador}" Width="180" />
                                        <DataGridTextColumn Header="Cupo Máx." Binding="{Binding CupoMaximo}" Width="90" />
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DATAGRID: PARTICIPANTES -->
                                <DataGrid ItemsSource="{Binding FilteredParticipantes}"
                                          SelectedItem="{Binding SelectedParticipante, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Participantes}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Invitación" Binding="{Binding IdInvitacion}" Width="160" />
                                        <DataGridTextColumn Header="Email Senderista" Binding="{Binding EmailSenderista}" Width="240" />
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130" />
                                        <DataGridTextColumn Header="Fecha de Registro" Binding="{Binding FechaRegistro}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DATAGRID: FRASES DIFICULTAD -->
                                <DataGrid ItemsSource="{Binding FilteredFrasesDificultad}"
                                          SelectedItem="{Binding SelectedFraseDificultad, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.FrasesDificultad}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Frase" Binding="{Binding Id}" Width="140" />
                                        <DataGridTextColumn Header="Nivel Dificultad" Binding="{Binding Dificultad}" Width="140" />
                                        <DataGridTextColumn Header="Frase / Mensaje" Binding="{Binding Frase}" Width="320" />
                                        <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="180" />
                                        <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activa}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DATAGRID: REQUISITOS SENDERISMO -->
                                <DataGrid ItemsSource="{Binding FilteredRequisitosSenderismo}"
                                          SelectedItem="{Binding SelectedRequisitoSenderismo, Mode=TwoWay}"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.RequisitosSenderismo}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Requisito" Binding="{Binding Id}" Width="140" />
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="150" />
                                        <DataGridTextColumn Header="Requisito" Binding="{Binding Requisito}" Width="260" />
                                        <DataGridTextColumn Header="Descripción Detallada" Binding="{Binding Descripcion}" Width="300" />
                                        <DataGridCheckBoxColumn Header="Obligatorio" Binding="{Binding EsObligatorio}" Width="100" />
                                        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Panel>

                            <!-- Footer Status Bar -->
                            <Border Grid.Row="2"
                                    Background="#0F172A"
                                    BorderBrush="#1E293B"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,8"
                                    Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="Registros en vista:" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding FilteredSenderistas.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Senderistas}}" />
                                        <TextBlock Text="{Binding FilteredRutas.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Rutas}}" />
                                        <TextBlock Text="{Binding FilteredAgrupaciones.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Agrupaciones}}" />
                                        <TextBlock Text="{Binding FilteredInvitaciones.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Invitaciones}}" />
                                        <TextBlock Text="{Binding FilteredParticipantes.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Participantes}}" />
                                        <TextBlock Text="{Binding FilteredFrasesDificultad.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.FrasesDificultad}}" />
                                        <TextBlock Text="{Binding FilteredRequisitosSenderismo.Count}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                                   IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.RequisitosSenderismo}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="💾 Caché local SQLite sincronizado" FontSize="11" Foreground="#10B981" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </TabItem>

                    <!-- ============================================== -->
                    <!-- TAB 2: FORMULARIO DE DETALLES Y EDICIÓN       -->
                    <!-- ============================================== -->
                    <TabItem Header="✏ Formulario de Detalle y Edición"
                             FontSize="13"
                             FontWeight="SemiBold"
                             IsEnabled="{Binding HasSelectedRecord}">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                                <!-- Form Navigation Bar & Header (Discreta, integrada y elegante para todas las tablas) -->
                                <Border Background="#131B2B"
                                        BorderBrush="#253248"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Left: Back Button & Context Title -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Button Classes="secondary"
                                                    Command="{Binding BackToGridCommand}"
                                                    Padding="10,6"
                                                    Height="32"
                                                    ToolTip.Tip="Regresar al listado general">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="←" FontWeight="Bold" FontSize="12" />
                                                    <TextBlock Text="Volver a la Lista" FontSize="11" />
                                                </StackPanel>
                                            </Button>

                                            <Border Width="1" Height="18" Background="#334155" VerticalAlignment="Center" Margin="2,0" />

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormTitle}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F8FAFC"
                                                           MaxWidth="500"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding FormTitle}" />
                                                <TextBlock Text="Sincronización API + Caché SQLite" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: Subtle Integrated Record Navigator -->
                                        <Border Grid.Column="2"
                                                Background="#0E1626"
                                                BorderBrush="#1E293B"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="4,2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="secondary"
                                                        Command="{Binding NavigateFirstRecordCommand}"
                                                        IsEnabled="{Binding CanNavigatePrevious}"
                                                        Padding="8,4"
                                                        Height="28"
                                                        ToolTip.Tip="Primer registro">
                                                    <TextBlock Text="⏮" FontSize="10" />
                                                </Button>

                                                <Button Classes="secondary"
                                                        Command="{Binding NavigatePreviousRecordCommand}"
                                                        IsEnabled="{Binding CanNavigatePrevious}"
                                                        Padding="8,4"
                                                        Height="28"
                                                        ToolTip.Tip="Registro anterior">
                                                    <TextBlock Text="◀" FontSize="10" />
                                                </Button>

                                                <Border Background="#16253B"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        Margin="2,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RecordNavigationStatus}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#38BDF8"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Button Classes="secondary"
                                                        Command="{Binding NavigateNextRecordCommand}"
                                                        IsEnabled="{Binding CanNavigateNext}"
                                                        Padding="8,4"
                                                        Height="28"
                                                        ToolTip.Tip="Siguiente registro">
                                                    <TextBlock Text="▶" FontSize="10" />
                                                </Button>

                                                <Button Classes="secondary"
                                                        Command="{Binding NavigateLastRecordCommand}"
                                                        IsEnabled="{Binding CanNavigateNext}"
                                                        Padding="8,4"
                                                        Height="28"
                                                        ToolTip.Tip="Último registro">
                                                    <TextBlock Text="⏭" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- FORMULARIO: SENDERISTA -->
                                <StackPanel Spacing="14"
                                            IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Senderistas}}">

                                    <!-- SECCIÓN 1: DATOS DEL PERFIL (SOLO LECTURA) -->
                                    <Border Background="#101726"
                                            BorderBrush="#1E293B"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="👤" FontSize="14" />
                                                <TextBlock Text="Datos Registrados del Senderista (Solo Lectura)"
                                                           FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" />
                                            </StackPanel>

                                            <!-- Grid balanceado de 12 columnas: Correo y Nombre más amplios y destacados -->
                                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">

                                                <!-- Fila 0, Col 0 a 4 (5 col): Correo (Mail / Clave) -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,6,10" Spacing="4">
                                                    <TextBlock Text="Correo Electrónico (Mail / Clave)" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                                                    <TextBox Text="{Binding FormSenderista.Email}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="34"
                                                             FontSize="13"
                                                             FontWeight="SemiBold"
                                                             Background="#151E2E"
                                                             Foreground="#F1F5F9"
                                                             BorderBrush="#253248" />
                                                </StackPanel>

                                                <!-- Fila 0, Col 5 a 9 (5 col): Nombre Completo -->
                                                <StackPanel Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="5" Margin="4,0,6,10" Spacing="4">
                                                    <TextBlock Text="Nombre Completo" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                                                    <TextBox Text="{Binding FormSenderista.Nombre}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="34"
                                                             FontSize="13"
                                                             FontWeight="SemiBold"
                                                             Background="#151E2E"
                                                             Foreground="#F1F5F9"
                                                             BorderBrush="#253248" />
                                                </StackPanel>

                                                <!-- Fila 0, Col 10 a 11 (2 col): Teléfono -->
                                                <StackPanel Grid.Row="0" Grid.Column="10" Grid.ColumnSpan="2" Margin="4,0,0,10" Spacing="4">
                                                    <TextBlock Text="Teléfono" FontWeight="Medium" FontSize="11" Foreground="#64748B" />
                                                    <TextBox Text="{Binding FormSenderista.Telefono}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="34"
                                                             FontSize="12"
                                                             Background="#151E2E"
                                                             Foreground="#94A3B8"
                                                             BorderBrush="#253248" />
                                                </StackPanel>

                                                <!-- Fila 1, Col 0 a 2 (3 col): ID Agrupación Registrada -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,6,0" Spacing="4">
                                                    <TextBlock Text="ID Agrupación Registrada" FontWeight="Medium" FontSize="11" Foreground="#38BDF8" />
                                                    <TextBox Text="{Binding FormSenderista.IdAgrupacion}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="32"
                                                             FontSize="12"
                                                             Background="#151E2E"
                                                             Foreground="#38BDF8"
                                                             BorderBrush="#0284C7" />
                                                </StackPanel>

                                                <!-- Fila 1, Col 3 a 5 (3 col): Nivel de Senderismo -->
                                                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Margin="4,0,6,0" Spacing="4">
                                                    <TextBlock Text="Nivel de Senderismo" FontWeight="Medium" FontSize="11" Foreground="#64748B" />
                                                    <TextBox Text="{Binding FormSenderista.NivelSenderista}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="32"
                                                             FontSize="12"
                                                             Background="#151E2E"
                                                             Foreground="#94A3B8"
                                                             BorderBrush="#253248" />
                                                </StackPanel>

                                                <!-- Fila 1, Col 6 a 8 (3 col): Fecha de Nacimiento -->
                                                <StackPanel Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="3" Margin="4,0,6,0" Spacing="4">
                                                    <TextBlock Text="Fecha de Nacimiento" FontWeight="Medium" FontSize="11" Foreground="#64748B" />
                                                    <TextBox Text="{Binding FormSenderista.FechaNacimiento}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="32"
                                                             FontSize="12"
                                                             Background="#151E2E"
                                                             Foreground="#94A3B8"
                                                             BorderBrush="#253248" />
                                                </StackPanel>

                                                <!-- Fila 1, Col 9 a 11 (3 col): Sexo -->
                                                <StackPanel Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="3" Margin="4,0,0,0" Spacing="4">
                                                    <TextBlock Text="Sexo" FontWeight="Medium" FontSize="11" Foreground="#64748B" />
                                                    <TextBox Text="{Binding FormSenderista.Sexo}"
                                                             IsReadOnly="True"
                                                             Focusable="False"
                                                             Height="32"
                                                             FontSize="12"
                                                             Background="#151E2E"
                                                             Foreground="#94A3B8"
                                                             BorderBrush="#253248" />
                                                </StackPanel>

                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECCIÓN 2: PARÁMETROS EDITABLES (ROL, BLOQUEO, MÍNIMA DISTANCIA) EN 4 COLUMNAS -->
                                    <Border Background="#162235"
                                            BorderBrush="#2563EB"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="✏" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="Parámetros Modificables por el Administrador"
                                                           FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" Margin="0,2,0,0">
                                                <!-- Col 0: Rol (Dropdown / ComboBox) -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="3">
                                                    <TextBlock Text="Rol en el Sistema (Permisos)" FontWeight="Medium" FontSize="11" Foreground="#E2E8F0" />
                                                    <ComboBox ItemsSource="{Binding AvailableRoles}"
                                                              SelectedItem="{Binding SelectedRoleOption, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanEditFormSenderistaRole}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>

                                                <!-- Col 1: Agrupación Asignada -->
                                                <StackPanel Grid.Column="1" Margin="4,0,6,0" Spacing="3">
                                                    <TextBlock Text="Agrupación Asignada" FontWeight="Medium" FontSize="11" Foreground="#E2E8F0" />
                                                    <ComboBox ItemsSource="{Binding AvailableAgrupaciones}"
                                                              SelectedItem="{Binding SelectedFormAgrupacion, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Nombre}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Col 2: Mínima Distancia (km) -->
                                                <StackPanel Grid.Column="2" Margin="4,0,6,0" Spacing="3">
                                                    <TextBlock Text="Mínima Distancia (Kilómetros)" FontWeight="Medium" FontSize="11" Foreground="#E2E8F0" />
                                                    <TextBox Text="{Binding FormSenderista.MinimoLongitud, Mode=TwoWay}"
                                                             Watermark="Ej. 4, 8, 15 (km)" />
                                                </StackPanel>

                                                <!-- Col 3: Bloquear Usuario -->
                                                <StackPanel Grid.Column="3" Margin="4,0,0,0" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="Estado de Acceso" FontWeight="Medium" FontSize="11" Foreground="#E2E8F0" />
                                                    <CheckBox IsChecked="{Binding FormSenderista.Bloqueado, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanEditFormSenderistaBloqueado}"
                                                              Content="Bloquear usuario"
                                                              FontWeight="SemiBold"
                                                              Foreground="#F87171"
                                                              Height="32"
                                                              VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Aviso de restricción de seguridad (si aplica) -->
                                            <TextBlock Text="{Binding SenderistaRoleRestrictionMessage}"
                                                       Foreground="#F59E0B"
                                                       FontSize="11"
                                                       IsVisible="{Binding SenderistaRoleRestrictionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- FORMULARIO: RUTA (LAYOUT DE 2 COLUMNAS: DETALLES COLAPSABLES DE 250px Y MAPA LIBRE EXPANDIDO) -->
                                <Grid ColumnDefinitions="Auto,*"
                                      Margin="0"
                                      IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Rutas}}">

                                    <!-- COLUMNA 0: DETALLES DE LA RUTA (ANCHO REDUCIDO A LA MITAD: 250px / COLAPSABLE) -->
                                    <Panel Grid.Column="0">
                                        <!-- TIRA VERTICAL CUANDO ESTÁ OCULTO -->
                                        <Button Command="{Binding ToggleRouteDetailsCommand}"
                                                Classes="secondary"
                                                Width="32"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Mostrar ficha técnica de la ruta"
                                                IsVisible="{Binding !IsRouteDetailsVisible}">
                                            <TextBlock Text="▶&#x0a;F&#x0a;I&#x0a;C&#x0a;H&#x0a;A"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#38BDF8"
                                                       TextAlignment="Center" />
                                        </Button>

                                        <!-- PANEL DE FICHA TÉCNICA (250px) -->
                                        <Border Width="250"
                                                Margin="0,0,12,0"
                                                IsVisible="{Binding IsRouteDetailsVisible}">
                                            <StackPanel Spacing="10">

                                                <!-- Header de Ficha con Botón de Ocultar -->
                                                <Border Background="#1E293B"
                                                        BorderBrush="#38BDF8"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="🔒" FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="Ficha de Ruta" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding ToggleRouteDetailsCommand}"
                                                                Padding="6,3"
                                                                Classes="secondary"
                                                                ToolTip.Tip="Ocultar ficha para maximizar el mapa">
                                                            <TextBlock Text="◀ Ocultar" FontSize="10" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- 1. CAMPO MODIFICABLE: AGRUPACIÓN Y ACCIONES RÁPIDAS -->
                                                <Border Background="#064E3B"
                                                        BorderBrush="#10B981"
                                                        BorderThickness="1.5"
                                                        CornerRadius="6"
                                                        Padding="10,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="Agrupación" FontWeight="Bold" FontSize="11" Foreground="#34D399" />
                                                            <TextBlock Grid.Column="1" Text="Editable ✏" FontSize="10" Foreground="#A7F3D0" />
                                                        </Grid>
                                                        <ComboBox ItemsSource="{Binding AvailableAgrupaciones}"
                                                                  SelectedItem="{Binding SelectedFormRutaAgrupacion, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  Height="26"
                                                                  FontSize="10">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Agrupacion">
                                                                    <TextBlock Text="{Binding Nombre}" FontSize="10" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBox Text="{Binding FormRuta.Agrupacion, Mode=TwoWay}"
                                                                 Watermark="ID Agrupación..."
                                                                 Background="#0A1E17"
                                                                 BorderBrush="#059669"
                                                                 Foreground="#FFFFFF"
                                                                 FontSize="10"
                                                                 Height="24"
                                                                 Padding="6,2" />

                                                        <!-- Botones de Acción Inmediata -->
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                            <Button Grid.Column="0"
                                                                    Classes="primary"
                                                                    Command="{Binding SaveFormCommand}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    Margin="0,0,4,0"
                                                                    Height="28"
                                                                    Padding="4,0">
                                                                <TextBlock Text="💾 Guardar" FontWeight="SemiBold" FontSize="10" />
                                                            </Button>

                                                            <Button Grid.Column="1"
                                                                    Classes="danger"
                                                                    Command="{Binding DeleteCurrentFormRecordCommand}"
                                                                    IsEnabled="{Binding CanDeleteFormRecord}"
                                                                    Height="28"
                                                                    Padding="6,0"
                                                                    ToolTip.Tip="Eliminar esta ruta">
                                                                <TextBlock Text="🗑 Eliminar" FontSize="10" />
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 2. DATOS TÉCNICOS COMPACTOS (Solo Lectura) -->
                                                <Border Background="#101726"
                                                        BorderBrush="#1E293B"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Métricas Técnicas (Solo Lectura)" FontWeight="SemiBold" FontSize="10" Foreground="#94A3B8" />

                                                        <!-- ID y Código -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="ID Ruta" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.Id, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" Spacing="1">
                                                                <TextBlock Text="Código" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.Codigo, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Dificultad y Pública -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="Dificultad" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.Dificultad, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding FormRuta.Publico, Mode=OneWay}"
                                                                          IsEnabled="False"
                                                                          Content="Pública"
                                                                          FontSize="10"
                                                                          Foreground="#CBD5E1"
                                                                          Margin="0,8,0,0" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Distancia GPS (3 dec) y Duración -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="Distancia GPS" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.DistanciaKmFormateada, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" Spacing="1">
                                                                <TextBlock Text="Duración" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.DuracionFormateada, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Conectividad % y Beacons -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="Señal / Conect." FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.Conectividad, Mode=OneWay, StringFormat='{}{0:F1} %'}" IsReadOnly="True" Background="#0B0F19" Foreground="#34D399" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" Spacing="1">
                                                                <TextBlock Text="Beacons (m)" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.DistanciaBeacons, Mode=OneWay, StringFormat='{}{0} m'}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Desnivel + y Desnivel - -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="Desnivel +" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.DesnivelPositivo, Mode=OneWay, StringFormat='▲ +{0:F0} m'}" IsReadOnly="True" Background="#0B0F19" Foreground="#10B981" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" Spacing="1">
                                                                <TextBlock Text="Desnivel -" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.DesnivelNegativo, Mode=OneWay, StringFormat='▼ -{0:F0} m'}" IsReadOnly="True" Background="#0B0F19" Foreground="#EF4444" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Subidas y Bajadas -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="Subidas" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.ContadorSubidas, Mode=OneWay, StringFormat='Sub: {0}'}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" Spacing="1">
                                                                <TextBlock Text="Bajadas" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.ContadorBajadas, Mode=OneWay, StringFormat='Baj: {0}'}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Latitud y Longitud Origen (3 decimales) -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Margin="0,0,3,0" Spacing="1">
                                                                <TextBlock Text="Latitud (3 dec)" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.LatitudOrig, Mode=OneWay, StringFormat='{}{0:F3}'}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" Spacing="1">
                                                                <TextBlock Text="Longitud (3 dec)" FontSize="9" Foreground="#64748B" />
                                                                <TextBox Text="{Binding FormRuta.LongitudOrig, Mode=OneWay, StringFormat='{}{0:F3}'}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Creador (Email y Teléfono) -->
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="Creador de Ruta" FontSize="9" Foreground="#64748B" />
                                                            <TextBox Text="{Binding FormRuta.EmailCreador, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#CBD5E1" FontSize="10" Height="22" Padding="4,1" />
                                                        </StackPanel>

                                                        <!-- Nombre de la Ruta -->
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="Nombre" FontSize="9" Foreground="#64748B" />
                                                            <TextBox Text="{Binding FormRuta.Nombre, Mode=OneWay}" IsReadOnly="True" Background="#0B0F19" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="10" Height="22" Padding="4,1" />
                                                        </StackPanel>

                                                        <!-- Descripción -->
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="Descripción" FontSize="9" Foreground="#64748B" />
                                                            <TextBox Text="{Binding FormRuta.Descripcion, Mode=OneWay}"
                                                                     IsReadOnly="True"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     Height="36"
                                                                     Background="#0B0F19"
                                                                     Foreground="#CBD5E1"
                                                                     FontSize="9"
                                                                     Padding="4,2" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                            </StackPanel>
                                        </Border>
                                    </Panel>

                                    <!-- COLUMNA 1: EL LIBRO (ABARCA TODA LA PÁGINA) -->
                                    <Border Grid.Column="1"
                                            Background="#131B2B"
                                            BorderBrush="#253248"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            VerticalAlignment="Stretch">
                                        <StackPanel Spacing="12">
                                            <!-- Header del Book con Botón de Alternar Ficha -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Command="{Binding ToggleRouteDetailsCommand}"
                                                            Classes="secondary"
                                                            Padding="8,4"
                                                            FontSize="11"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RouteDetailsToggleText}" FontWeight="SemiBold" />
                                                    </Button>
                                                    <TextBlock Text="📂 Libro de Ruta" FontWeight="SemiBold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    <Border Background="#0C4A6E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentPuntoItems.Count, StringFormat='{}{0} Puntos'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentRouteDetails.Traza.Count, StringFormat='{}{0} Puntos GPS'}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Botón directo para Guardar y Sincronizar Ruta -->
                                                <Button Grid.Column="1"
                                                        Classes="primary"
                                                        Command="{Binding SaveCurrentRouteCommand}"
                                                        Padding="12,5"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Guardar y sincronizar los cambios de esta ruta en PostgreSQL y SQLite">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="💾" />
                                                        <TextBlock Text="Sincronizar Ruta" FontWeight="Bold" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- TabControl de 2 pestañas -->
                                            <TabControl SelectedIndex="{Binding RouteBookTabIndex, Mode=TwoWay}"
                                                        MinHeight="580">

                                                <!-- PÁGINA 1: FAROS (PUNTOS Y FOTOS) -->
                                                <TabItem Header="📍 Faros">
                                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                                        <TextBlock Text="Waypoints registrados en la ruta y evidencias fotográficas (Cloudinary). Puede retirar o bloquear fotos reportadas directamente:"
                                                                   FontSize="11" Foreground="#94A3B8" />

                                                        <!-- Mensaje si no hay puntos -->
                                                        <Border Background="#0B0F19"
                                                                BorderBrush="#1E293B"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="20"
                                                                IsVisible="{Binding !CurrentPuntoItems.Count}">
                                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                                <TextBlock Text="ℹ No hay puntos registrados o desencriptados para esta ruta."
                                                                           Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Listado de Puntos -->
                                                        <ItemsControl ItemsSource="{Binding CurrentPuntoItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:PuntoRutaItem">
                                                                    <Border Background="#0F172A"
                                                                            BorderBrush="#1E293B"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="12"
                                                                            Margin="0,0,0,10">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <!-- Número / Icono -->
                                                                            <Border Grid.Column="0"
                                                                                    Width="34" Height="34"
                                                                                    CornerRadius="17"
                                                                                    Background="#1E293B"
                                                                                    BorderBrush="#F59E0B"
                                                                                    BorderThickness="1.5"
                                                                                    Margin="0,0,12,0"
                                                                                    VerticalAlignment="Top">
                                                                                <TextBlock Text="{Binding Index}"
                                                                                           Foreground="#F59E0B"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="12"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <!-- Información del Punto -->
                                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="{Binding Nombre}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="13"
                                                                                               Foreground="#F8FAFC" />
                                                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding ConectividadPctFormateada}" FontSize="10" Foreground="#34D399" />
                                                                                    </Border>
                                                                                </StackPanel>

                                                                                <TextBlock Text="{Binding Descripcion}"
                                                                                           FontSize="12"
                                                                                           Foreground="#94A3B8"
                                                                                           TextWrapping="Wrap" />

                                                                                <TextBlock Text="{Binding CoordenadasFormateadas}"
                                                                                           FontSize="11"
                                                                                           Foreground="#64748B" />

                                                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                                                                    <Button Content="🗺️ Ver en Recorrido"
                                                                                            Command="{Binding VerEnMapaCommand}"
                                                                                            Classes="secondary"
                                                                                            FontSize="10"
                                                                                            Padding="8,4"
                                                                                            ToolTip.Tip="Centrar y ampliar este faro directamente en el mapa interactivo de recorrido" />

                                                                                    <Button Content="🗑️ Eliminar Punto"
                                                                                            Command="{Binding EliminarPuntoCommand}"
                                                                                            Classes="danger"
                                                                                            FontSize="10"
                                                                                            Padding="8,4"
                                                                                            ToolTip.Tip="Eliminar este punto pero conservando la traza GPS para seguir el camino" />
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <!-- Foto Cloudinary (Miniatura y Botones: Ver / Bloquear) -->
                                                                            <StackPanel Grid.Column="2"
                                                                                        Margin="12,0,0,0"
                                                                                        Spacing="4"
                                                                                        VerticalAlignment="Center"
                                                                                        IsVisible="{Binding HasFoto}">
                                                                                <!-- Miniatura interactiva: al dar clic agranda la foto -->
                                                                                <Button Command="{Binding VerFotoCommand}"
                                                                                        Width="80" Height="80"
                                                                                        Padding="0"
                                                                                        CornerRadius="6"
                                                                                        ClipToBounds="True"
                                                                                        Background="#070B14"
                                                                                        BorderBrush="#EC4899"
                                                                                        BorderThickness="1.5"
                                                                                        Cursor="Hand"
                                                                                        HorizontalContentAlignment="Center"
                                                                                        VerticalContentAlignment="Center"
                                                                                        ToolTip.Tip="Clic para agrandar foto">
                                                                                    <Panel Width="80" Height="80">
                                                                                        <Image Source="{Binding FotoBitmap}"
                                                                                               Stretch="UniformToFill" />
                                                                                        <ProgressBar IsIndeterminate="True"
                                                                                                     IsVisible="{Binding IsLoadingPhoto}"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center" />
                                                                                    </Panel>
                                                                                </Button>

                                                                                <!-- Botón Clic para agrandar foto -->
                                                                                <Button Content="🔍 Clic para agrandar foto"
                                                                                        Command="{Binding VerFotoCommand}"
                                                                                        FontSize="9"
                                                                                        FontWeight="SemiBold"
                                                                                        Padding="4,4"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        HorizontalContentAlignment="Center"
                                                                                        ToolTip.Tip="Clic para agrandar foto" />

                                                                                <!-- Botón Bloquear / Quitar Foto -->
                                                                                <Button Content="🚫 Moderar Foto"
                                                                                        Command="{Binding BloquearFotoCommand}"
                                                                                        Classes="danger"
                                                                                        FontSize="10"
                                                                                        Padding="6,3"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        HorizontalContentAlignment="Center"
                                                                                        ToolTip.Tip="Eliminar punto o sustituir foto por aviso con el motivo de retiro" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </TabItem>

                                                <!-- PÁGINA 2: RECORRIDO (MAPA CON TRAZA Y FAROS) -->
                                                <TabItem Header="🗺️ Recorrido">
                                                    <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                                                        <!-- Barra de Herramientas del Mapa Libre -->
                                                        <Border Grid.Row="0"
                                                                Background="#0F172A"
                                                                BorderBrush="#1E293B"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10,6"
                                                                Margin="0,0,0,8">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- Botón Ocultar/Mostrar Ficha -->
                                                                <Button Grid.Column="0"
                                                                        Command="{Binding ToggleRouteDetailsCommand}"
                                                                        Content="{Binding RouteDetailsToggleText}"
                                                                        Classes="secondary"
                                                                        Padding="8,4"
                                                                        FontSize="10"
                                                                        Margin="0,0,10,0" />

                                                                <!-- Selector de Capas Libres -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="Capa:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                                    <Button Content="🌐 OpenStreetMap" Click="OnSetOsmLayer" Padding="6,3" FontSize="10" Classes="secondary" ToolTip.Tip="Capa libre comunitaria OpenStreetMap" />
                                                                    <Button Content="🗺️ Carto Voyager" Click="OnSetCartoLayer" Padding="6,3" FontSize="10" Classes="secondary" ToolTip.Tip="Capa libre optimizada para caminos y senderos" />
                                                                    <Button Content="⛰️ OpenTopo" Click="OnSetTopoLayer" Padding="6,3" FontSize="10" Classes="secondary" ToolTip.Tip="Curvas de nivel y topografía libre" />
                                                                    <Button Content="⬛ Vectorial" Click="OnSetVectorLayer" Padding="6,3" FontSize="10" Classes="secondary" ToolTip.Tip="Modo oscuro vectorial" />
                                                                </StackPanel>

                                                                <!-- Controles y Enlace Web -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="🌍 Ver en Web"
                                                                            Command="{Binding OpenOpenStreetMapWebCommand}"
                                                                            Padding="8,4"
                                                                            FontSize="10"
                                                                            Classes="secondary"
                                                                            ToolTip.Tip="Abrir la ruta directamente en OpenStreetMap en el navegador web" />
                                                                    <Button x:Name="BtnMapZoomIn" Content="➕" Padding="8,4" ToolTip.Tip="Acercar" Click="OnZoomInClick" />
                                                                    <Button x:Name="BtnMapZoomOut" Content="➖" Padding="8,4" ToolTip.Tip="Alejar" Click="OnZoomOutClick" />
                                                                    <Button x:Name="BtnMapReset" Content="⟲ Centrar" Padding="8,4" ToolTip.Tip="Restablecer vista a la ruta" Click="OnResetMapClick" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Lienzo de SkiaSharp / OpenStreetMap Tiles -->
                                                        <Border Grid.Row="1"
                                                                Background="#050811"
                                                                BorderBrush="#1E293B"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                MinHeight="520"
                                                                ClipToBounds="True">
                                                            <views:RouteMapControl x:Name="RouteMap"
                                                                                   Traza="{Binding CurrentRouteDetails.Traza}"
                                                                                   Puntos="{Binding CurrentRouteDetails.Puntos}"
                                                                                   HorizontalAlignment="Stretch"
                                                                                   VerticalAlignment="Stretch" />
                                                        </Border>
                                                    </Grid>
                                                </TabItem>
                                            </TabControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- FORMULARIO: AGRUPACION -->
                                <StackPanel Spacing="12"
                                            IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Agrupaciones}}">

                                    <!-- LOGO DE LA AGRUPACION (AL PRINCIPIO) -->
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <!-- Preview del Logo -->
                                            <Border Grid.Column="0" Width="84" Height="84" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                <Panel>
                                                    <Image Source="{Binding FormAgrupacionLogoBitmap}"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasAgrupacionLogo}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                                                                IsVisible="{Binding !HasAgrupacionLogo}">
                                                        <TextBlock Text="📷" FontSize="22" HorizontalAlignment="Center" Opacity="0.6" />
                                                        <TextBlock Text="Sin logo" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Panel>
                                            </Border>

                                            <!-- Controles del Logo -->
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="Logo de la Agrupación (Imagen)" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                <TextBlock Text="{Binding FormAgrupacion.LogoSizeText, StringFormat='Estado: {0}'}" FontSize="11" Foreground="#94A3B8" />

                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                    <Button Content="📁 Seleccionar Imagen..."
                                                            Command="{Binding SelectAgrupacionLogoCommand}"
                                                            Background="#0284C7"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            FontSize="11"
                                                            Padding="10,6"
                                                            CornerRadius="5" />

                                                    <Button Content="🗑️ Quitar Logo"
                                                            Command="{Binding RemoveAgrupacionLogoCommand}"
                                                            IsVisible="{Binding HasAgrupacionLogo}"
                                                            Background="#DC2626"
                                                            Foreground="White"
                                                            FontSize="11"
                                                            Padding="10,6"
                                                            CornerRadius="5" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- DATOS GENERALES Y DE CONTACTO -->
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0">
                                        <!-- Fila 0: ID y Nombre -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="ID Agrupación" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.IdAgrupacion, Mode=TwoWay}" IsEnabled="{Binding IsNewRecord}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Nombre" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.Nombre, Mode=TwoWay}" />
                                        </StackPanel>

                                        <!-- Fila 1: Responsable y Email -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Responsable / Representante" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.Responsable, Mode=TwoWay}" Watermark="Nombre del responsable del club o grupo" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Correo Electrónico (Email)" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.Email, Mode=TwoWay}" Watermark="ej: contacto@agrupacion.org" />
                                        </StackPanel>

                                        <!-- Fila 2: Teléfono y Fecha de Creación -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Teléfono de Contacto" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.Telefono, Mode=TwoWay}" Watermark="ej: 3121234567" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Fecha de Creación" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.FechaCreacion, Mode=TwoWay}" Watermark="ej: 2026-05-12" />
                                        </StackPanel>

                                        <!-- Fila 3: Ciudad y Contacto Alternativo -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Ciudad" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.Ciudad, Mode=TwoWay}" Watermark="Ciudad o localidad" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Contacto Alternativo" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormAgrupacion.Contacto, Mode=TwoWay}" Watermark="Contacto o medio adicional" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- DESCRIPCION -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Descripción" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                        <TextBox Text="{Binding FormAgrupacion.Descripcion, Mode=TwoWay}" AcceptsReturn="True" Height="70" />
                                    </StackPanel>

                                    <!-- METADATOS DE SINCRONIZACIÓN (FUPDATE) -->
                                    <Border Background="#151E2E" BorderBrush="#253248" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,2,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="⏱️ Última sincronización en servidor (fupdate):" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding FormAgrupacion.Fupdate, TargetNullValue='No sincronizado aún'}"
                                                       FontSize="11" FontWeight="Medium" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- CLAVE / ADMINISTRADORES (ROL 'A') AL FINAL -->
                                    <StackPanel Spacing="6" Margin="0,4,0,4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Clave / Administradores de la Agrupación (Rol 'A')" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                            <TextBlock Grid.Column="1" Text="Correos autorizados (separados por coma)" FontSize="11" Foreground="#94A3B8" />
                                        </Grid>
                                        <TextBox Text="{Binding FormAgrupacion.Clave, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="85"
                                                 Height="95"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Background="#0F172A"
                                                 BorderBrush="#0284C7"
                                                 Foreground="#F8FAFC"
                                                 FontFamily="Consolas, Cascadia Code, monospace"
                                                 FontSize="12"
                                                 Padding="10,8"
                                                 Watermark="ejemplo: admin1@correo.com, admin2@correo.com" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- FORMULARIO: INVITACION -->
                                <StackPanel Spacing="12"
                                            IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Invitaciones}}">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="ID Invitación" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormInvitacion.IdInvitacion, Mode=TwoWay}" IsEnabled="{Binding IsNewRecord}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Título de la Salida" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormInvitacion.Titulo, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="ID Ruta Asociada" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormInvitacion.IdRuta, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Fecha y Hora de Salida" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormInvitacion.FechaSalida, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Punto de Encuentro" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormInvitacion.PuntoEncuentro, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Estado" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormInvitacion.Estado, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- FORMULARIO: PARTICIPANTE -->
                                <StackPanel Spacing="12"
                                            IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.Participantes}}">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="ID Invitación" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormParticipante.IdInvitacion, Mode=TwoWay}" IsEnabled="{Binding IsNewRecord}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Email Senderista" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormParticipante.EmailSenderista, Mode=TwoWay}" IsEnabled="{Binding IsNewRecord}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Estado (Inscrito, Confirmado...)" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormParticipante.Estado, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Fecha de Registro" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormParticipante.FechaRegistro, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- FORMULARIO: FRASE DIFICULTAD -->
                                <StackPanel Spacing="12"
                                            IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.FrasesDificultad}}">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="ID Frase (Clave Primaria)" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormFraseDificultad.Id, Mode=TwoWay}" IsEnabled="{Binding IsNewRecord}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Nivel de Dificultad (Fácil, Moderada, Difícil, Extrema)" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormFraseDificultad.Dificultad, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Autor / Fuente" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormFraseDificultad.Autor, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,22,0,10">
                                            <CheckBox IsChecked="{Binding FormFraseDificultad.Activa, Mode=TwoWay}" Content="Frase Activa" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Frase Motivacional o Descriptiva" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                        <TextBox Text="{Binding FormFraseDificultad.Frase, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 Height="70" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- FORMULARIO: REQUISITO SENDERISMO -->
                                <StackPanel Spacing="12"
                                            IsVisible="{Binding CurrentTable, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActiveTable.RequisitosSenderismo}}">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="ID Requisito (Clave Primaria)" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormRequisitoSenderismo.Id, Mode=TwoWay}" IsEnabled="{Binding IsNewRecord}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                            <TextBlock Text="Categoría (Equipo Básico, Condición Física, Vestimenta, Seguridad...)" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormRequisitoSenderismo.Categoria, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                            <TextBlock Text="Nombre del Requisito" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBox Text="{Binding FormRequisitoSenderismo.Requisito, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,22,0,10" Orientation="Horizontal" Spacing="16">
                                            <CheckBox IsChecked="{Binding FormRequisitoSenderismo.EsObligatorio, Mode=TwoWay}" Content="Es Obligatorio" />
                                            <CheckBox IsChecked="{Binding FormRequisitoSenderismo.Activo, Mode=TwoWay}" Content="Activo" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Descripción / Recomendaciones" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" />
                                        <TextBox Text="{Binding FormRequisitoSenderismo.Descripcion, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 Height="70" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Form Action Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                                    <Button Classes="primary"
                                            Command="{Binding SaveFormCommand}"
                                            Height="38">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="💾" />
                                            <TextBlock Text="Guardar Cambios (API + SQLite)" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="danger"
                                            Command="{Binding DeleteCurrentFormRecordCommand}"
                                            IsEnabled="{Binding CanDeleteFormRecord}"
                                            Height="38"
                                            ToolTip.Tip="Eliminar este registro de la base de datos">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🗑" />
                                            <TextBlock Text="Eliminar Registro" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="secondary"
                                            Command="{Binding NewRecordCommand}"
                                            IsVisible="{Binding CanCreateNew}"
                                            Height="38">
                                        <TextBlock Text="Limpiar / Nuevo" />
                                    </Button>

                                    <Button Classes="secondary"
                                            Command="{Binding BackToGridCommand}"
                                            Height="38">
                                        <TextBlock Text="Cancelar y Volver al Grid" />
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>
        <!-- End of Row 2 Grid -->
    </Grid>
    <!-- End of Main Content Grid -->

        <!-- MODAL DE CONFIRMACIÓN -->
        <Border Background="#CC070B14"
                IsVisible="{Binding IsConfirmDialogVisible}">
            <Border Background="#162235"
                    BorderBrush="{Binding ConfirmDialogBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Width="520"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 14 40 0 #99000000">
                <StackPanel Spacing="16">
                    <!-- Icon & Title Header -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Background="{Binding ConfirmDialogIconBgBrush}" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                            <TextBlock Text="{Binding ConfirmDialogIcon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConfirmDialogTitle}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{Binding ConfirmDialogHeaderBrush}" />
                            <TextBlock Text="{Binding ConfirmDialogSubtitle}"
                                       FontSize="11"
                                       Foreground="{Binding ConfirmDialogSubtitleBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Message Body Box -->
                    <Border Background="#0F172A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <TextBlock Text="{Binding ConfirmDialogMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#F1F5F9"
                                   LineHeight="20" />
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,6,0,0">
                        <Button Classes="secondary"
                                Command="{Binding CancelDeleteCommand}"
                                Padding="18,9"
                                Height="38">
                            <TextBlock Text="Cancelar" FontWeight="Medium" FontSize="13" />
                        </Button>
                        <Button Classes="primary"
                                IsVisible="{Binding !ConfirmDialogIsDanger}"
                                Command="{Binding ConfirmDeleteCommand}"
                                Padding="18,9"
                                Height="38">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ConfirmDialogIcon}" />
                                <TextBlock Text="{Binding ConfirmDialogConfirmText}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button Classes="danger"
                                IsVisible="{Binding ConfirmDialogIsDanger}"
                                Command="{Binding ConfirmDeleteCommand}"
                                Padding="18,9"
                                Height="38">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ConfirmDialogIcon}" />
                                <TextBlock Text="{Binding ConfirmDialogConfirmText}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================== -->
        <!-- MODAL DE VISUALIZACIÓN DE FOTO DE CLOUDINARY  -->
        <!-- ============================================== -->
        <Border Background="#D9000000"
                IsVisible="{Binding IsPhotoViewerOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="99">
            <Border Background="#131B2B"
                    BorderBrush="#253248"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    MaxWidth="760"
                    MaxHeight="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header Modal -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding CurrentViewingPhotoPoint.Descripcion}"
                                       FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding CurrentViewingPhotoPoint.CoordenadasTexto, StringFormat='Coordenadas: {0}'}"
                                       FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Command="{Binding ClosePhotoViewerCommand}"
                                Padding="8,4"
                                ToolTip.Tip="Cerrar visor">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Foto Ampliada -->
                    <Border Grid.Row="1"
                            Background="#070B14"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            MinHeight="360"
                            Margin="0,0,0,12">
                        <Panel>
                            <Image Source="{Binding CurrentViewingPhotoPoint.FotoBitmap}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding CurrentViewingPhotoPoint.IsLoadingPhoto}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Panel>
                    </Border>

                    <!-- Footer / Cloudinary Link y Moderación de Fotos -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentViewingPhotoPoint.FotoPath}"
                                   FontSize="10"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="1"
                                Classes="danger"
                                Command="{Binding RequestPointActionCommand}"
                                CommandParameter="{Binding CurrentViewingPhotoPoint}"
                                Margin="0,0,10,0"
                                Padding="12,6"
                                ToolTip.Tip="Eliminar este punto o sustituir la fotografía por un aviso con el motivo de retiro">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🚫" />
                                <TextBlock Text="Moderar Foto / Punto" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary"
                                Command="{Binding ClosePhotoViewerCommand}"
                                Padding="16,6">
                            <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============================================================== -->
        <!-- MODAL DE GESTIÓN Y MODERACIÓN DE PUNTO / FOTOGRAFÍA (2 MATICES) -->
        <!-- ============================================================== -->
        <Border Background="#E6000000"
                IsVisible="{Binding IsPointActionDialogVisible}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="110">
            <Border Background="#131B2B"
                    BorderBrush="#253248"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <!-- Encabezado -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding PointActionDialogTitle}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding PointActionDialogSubtitle}"
                                       FontSize="12"
                                       Foreground="#94A3B8" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Command="{Binding ClosePointActionDialogCommand}"
                                Padding="8,4"
                                ToolTip.Tip="Cancelar y cerrar">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- VISTA 1: ELECCIÓN DE ACCIÓN (2 MATICES) -->
                    <StackPanel Spacing="14" IsVisible="{Binding !IsMotiveInputVisible}">
                        <TextBlock Text="¿Qué acción desea realizar sobre este punto de la ruta?"
                                   FontSize="13"
                                   Foreground="#CBD5E1"
                                   FontWeight="SemiBold" />

                        <!-- Opción 1: Eliminar el Punto pero conservar la Traza GPS -->
                        <Border Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                    <TextBlock Text="🗺️ 1. Eliminar Punto (Conservar Traza GPS)"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#F1F5F9" />
                                    <TextBlock Text="Se eliminará el punto de control de la lista y del mapa, pero la traza GPS para seguir el camino se conservará íntegra para no alterar la ruta."
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="danger"
                                        Command="{Binding ConfirmDeletePointKeepTrazaCommand}"
                                        Padding="14,8"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Eliminar Punto" FontWeight="Bold" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Opción 2: Sustituir la foto por motivo de eliminación -->
                        <Border Background="#1E293B"
                                BorderBrush="#EAB308"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                IsVisible="{Binding TargetPointItem.TieneFoto}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                    <TextBlock Text="🖼️ 2. Sustituir Foto con Motivo de Retiro"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#FDE047" />
                                    <TextBlock Text="Se creará una imagen gráfica con fondo amarillo y letras bold negras exponiendo la frase/motivo, sustituyendo la foto original."
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Command="{Binding OpenMotiveInputCommand}"
                                        Padding="14,8"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Escribir Motivo" FontWeight="Bold" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Botón Cancelar -->
                        <Button Content="Cancelar"
                                Command="{Binding ClosePointActionDialogCommand}"
                                Classes="secondary"
                                HorizontalAlignment="Right"
                                Padding="16,6"
                                Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- VISTA 2: CAPTURA DE MOTIVO Y GENERACIÓN DE JPG AMARILLO -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsMotiveInputVisible}">
                        <TextBlock Text="Indique el motivo por el cual se retira la imagen:"
                                   FontSize="13"
                                   Foreground="#F8FAFC"
                                   FontWeight="SemiBold" />

                        <!-- Sugerencias rápidas de motivos -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Motivos frecuentes sugeridos:"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       FontWeight="SemiBold" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="secondary"
                                        Content="Fotografía no representativa"
                                        Command="{Binding SelectSuggestedMotiveCommand}"
                                        CommandParameter="Fotografía no representativa del camino o sendero"
                                        FontSize="10" Padding="8,3" Margin="0,0,6,6" />
                                <Button Classes="secondary"
                                        Content="Contenido inapropiado / Reportado"
                                        Command="{Binding SelectSuggestedMotiveCommand}"
                                        CommandParameter="Contenido inapropiado reportado por senderistas"
                                        FontSize="10" Padding="8,3" Margin="0,0,6,6" />
                                <Button Classes="secondary"
                                        Content="Foto borrosa o ilegible"
                                        Command="{Binding SelectSuggestedMotiveCommand}"
                                        CommandParameter="Fotografía borrosa o con calidad deficiente"
                                        FontSize="10" Padding="8,3" Margin="0,0,6,6" />
                                <Button Classes="secondary"
                                        Content="Privacidad / Rostros"
                                        Command="{Binding SelectSuggestedMotiveCommand}"
                                        CommandParameter="Privacidad: Rostros o personas no autorizadas"
                                        FontSize="10" Padding="8,3" Margin="0,0,6,6" />
                                <Button Classes="secondary"
                                        Content="Publicidad no relacionada"
                                        Command="{Binding SelectSuggestedMotiveCommand}"
                                        CommandParameter="Publicidad o material ajeno a la ruta"
                                        FontSize="10" Padding="8,3" Margin="0,0,6,6" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Caja de texto para el motivo personalizado -->
                        <TextBox Text="{Binding RemovalMotiveText, Mode=TwoWay}"
                                 Watermark="Escriba aquí la razón que se plasmará en la imagen amarilla..."
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 FontSize="12" />

                        <!-- Aviso visual -->
                        <Border Background="#282208"
                                BorderBrush="#EAB308"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Se generará un archivo JPG con fondo amarillo y texto bold negro que sustituirá la foto en el caché y en la base de datos."
                                           FontSize="11"
                                           Foreground="#FDE047"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Botones de Acción -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Classes="secondary"
                                    Command="{Binding BackToPointActionOptionsCommand}"
                                    Padding="14,6">
                                <TextBlock Text="◀ Volver" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="primary"
                                    Command="{Binding ConfirmReplacePhotoWithMotiveCommand}"
                                    Padding="18,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🖼️" />
                                    <TextBlock Text="Generar JPG y Sustituir Foto" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
