<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AdministracionSenderistas.ViewModels"
        x:Class="AdministracionSenderistas.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Administración Senderistas - Panel de Control BD &amp; PostgREST"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19">

    <TransitioningContentControl Content="{Binding CurrentView}" />
</Window>
